# Public contact email shown/used on the site. Defaults to arjun.singh@8octave.com
# in lib/site-config.ts if left blank here.
NEXT_PUBLIC_CONTACT_EMAIL=

# Required to enable the contact form server action to actually send email.
# Sign up at https://resend.com, add a verified sending domain (or use the
# shared onboarding@resend.dev sender for testing), then set:
RESEND_API_KEY=
